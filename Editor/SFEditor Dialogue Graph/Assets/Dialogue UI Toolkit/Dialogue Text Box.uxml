<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xmlns:ui="UnityEngine.UIElements" 
         noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" 
         editor-extension-mode="False">
    
    <ui:VisualElement name="dialogue__view">
        <ui:VisualElement name="dialogue-speaker__container" style="background-image: none;">
            <ui:Label name="dialogue-speaker__label" text="" class="overlay__label" />
        </ui:VisualElement>
        <ui:VisualElement name="dialogue-speech__container" class="overlay-content__container dialogue-speech__container">
            <ui:Label name="overlay-dialogue__label" text="" class="overlay__label" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
